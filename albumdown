console = Console()

# ─── URL Validation ───────────────────────────────────────────────

YOUTUBE_PLAYLIST_RE = re.compile(
    r"(?:https?://)?(?:www\.)?"
    r"(?:music\.)?youtube\.com/(?:playlist\?list=|watch\?.*list=)"
    r"([A-Za-z0-9_-]+)"
)


def validate_url(url: str) -> str | None:
    """Extract playlist ID from a YouTube/Music URL. Returns None if invalid."""
    m = YOUTUBE_PLAYLIST_RE.search(url)
    return m.group(1) if m else None


def is_album_url(url: str) -> bool:
    return validate_url(url) is not None


# ─── Metadata Extraction ──────────────────────────────────────────

def fetch_metadata(url: str) -> dict:
    """Fetch playlist metadata without downloading anything."""
    ydl_opts = {
        "quiet": True,
        "no_warnings": True,
        "extract_flat": False,
        "skip_download": True,
    }

    with yt_dlp.YoutubeDL(ydl_opts) as ydl:
        try:
            info = ydl.extract_info(url, download=False)
        except yt_dlp.utils.DownloadError as e:
            console.print("[bold red]Error:[/] Could not fetch playlist info.")
            console.print(f"[dim]{e}[/]")
            sys.exit(1)

    if not info:
        console.print("[bold red]Error:[/] No metadata returned.")
        sys.exit(1)

    # Single video — treat as 1-track "album"
    if info.get("_type") == "video" or not info.get("entries"):
        entries = [info]
        album_name = _clean_album(info.get("album") or info.get("title"))
        artist = _entry_artist(info) or _clean_artist(
            info.get("uploader")
            or info.get("channel")
            or "Unknown Artist"
        )
    else:
        entries = list(info.get("entries", []))
        valid = [e for e in entries if e is not None]

        # Album: the per-entry tag is cleaner than the playlist title
        # (YouTube Music titles often come prefixed: "Album - Lámina Once")
        album_name = ""
        for e in valid:
            if e.get("album"):
                album_name = _clean_album(e["album"])
                break
        if not album_name:
            album_name = _clean_playlist_title(info.get("title", "Unknown Album"))

        # Artist: per-entry tag first, then playlist uploader/channel
        artist = ""
        for e in valid:
            artist = _entry_artist(e)
            if artist:
                break
        if not artist:
            artist = _clean_artist(
                info.get("uploader")
                or info.get("channel")
                or ""
            )
        # Fallback: try first entry's uploader
        if not artist or artist.lower() in ("unknown artist", ""):
            first = valid[0] if valid else {}
            artist = _clean_artist(
                first.get("uploader")
                or first.get("channel")
                or "Unknown Artist"
            )

    valid_entries = [e for e in entries if e is not None]

    # Track numbers: YouTube Music has no track-number field (its "track"
    # key holds the song title) — the order lives in playlist_index.
    # Normalize it so display, filenames and the ID3 TRCK tag all agree.
    for idx, e in enumerate(valid_entries, 1):
        pi = e.get("playlist_index")
        if not isinstance(pi, int) or pi < 1:
            e["playlist_index"] = idx

    return {
        "album": album_name,
        "artist": artist,
        "entries": valid_entries,
        "url": url,
    }


def _clean_artist(name: str) -> str:
    """Strip common suffixes that YouTube adds to artist names."""
    if not name:
        return "Unknown Artist"
    # Remove "- Topic", "- Album", "- Single" suffixes
    name = re.sub(r"\s*-\s*(Topic|Album|Single|VEVO)$", "", name, flags=re.IGNORECASE)
    name = name.strip()
    return name or "Unknown Artist"


def _clean_album(name: str) -> str:
    """Clean album name."""
    if not name:
        return "Unknown Album"
    return name.strip()


def _clean_playlist_title(name: str) -> str:
    """Strip the prefixes YouTube Music puts on playlist titles ('Album - X')."""
    name = (name or "").strip()
    name = re.sub(r"^(full\s+album|album|lp|ep|single)\s*[-–—:]\s*", "", name, flags=re.IGNORECASE)
    return name.strip() or "Unknown Album"


def _entry_artist(entry: dict) -> str:
    """Per-song artist from its own metadata ('' if unavailable)."""
    artists = entry.get("artists")
    if isinstance(artists, list) and artists and artists[0]:
        return _clean_artist(str(artists[0]))
    a = entry.get("artist") or entry.get("creator")
    if a:
        return _clean_artist(str(a).split(",")[0].strip())
    return ""


# ─── Display ──────────────────────────────────────────────────────

def format_duration(seconds: int | float | None) -> str:
    if not seconds:
        return "??:??"
    total = int(seconds)
    h, remainder = divmod(total, 3600)
    m, s = divmod(remainder, 60)
    if h > 0:
        return f"{h}:{m:02d}:{s:02d}"
    return f"{m}:{s:02d}"


def display_tracklist(metadata: dict) -> None:
    album = metadata["album"]
    artist = metadata["artist"]
    entries = metadata["entries"]

    total_duration = sum(e.get("duration") or 0 for e in entries)
    track_count = len(entries)

    header = Text()
    header.append("🎵 ", style="bold")
    header.append(artist, style="bold cyan")
    header.append(" — ", style="dim")
    header.append(album, style="bold white")
    header.append(
        f"\n   {track_count} track{'s' if track_count != 1 else ''} • {format_duration(total_duration)} total",
        style="dim",
    )

    console.print()
    console.print(Panel(header, border_style="blue", box=box.ROUNDED))

    table = Table(box=box.SIMPLE_HEAVY, show_header=True, header_style="bold green", padding=(0, 1))
    table.add_column("#", style="dim", width=4, justify="right")
    table.add_column("Title", style="white", ratio=3)
    table.add_column("Duration", style="dim", justify="right")

    for i, entry in enumerate(entries, 1):
        title = entry.get("title") or entry.get("fulltitle") or f"Track {i}"
        duration = format_duration(entry.get("duration"))
        num = entry.get("playlist_index")
        if not isinstance(num, int):
            num = i
        table.add_row(f"{num:02d}", title, duration)

    console.print(table)
    console.print()


# ─── File System ──────────────────────────────────────────────────

def _sanitize(name: str) -> str:
    name = re.sub(r'[\\/:*?"<>|]', "_", name)
    name = re.sub(r"_+", "_", name).strip("_. ")
    return name or "Unknown"


def make_output_dir(metadata: dict, output_base: str) -> Path:
    """Create ~/Music/{Artist}/{Album}/ structure."""
    artist = _sanitize(metadata["artist"])
    album = _sanitize(metadata["album"])
    album_dir = Path(output_base) / artist / album
    album_dir.mkdir(parents=True, exist_ok=True)
    return album_dir


# ─── Metadata Embedding ───────────────────────────────────────────

def embed_metadata(filepath: Path, metadata: dict, track_num: int, title: str,
                    artist: str | None = None) -> bool:
    """Embed ID3 tags into an MP3 file. Returns True on success."""
    try:
        try:
            audio = MP3(str(filepath), ID3=ID3)
        except ID3NoHeaderError:
            audio = MP3(str(filepath))
            audio.add_tags()

        audio.tags.add(TIT2(encoding=3, text=[title]))
        audio.tags.add(TPE1(encoding=3, text=[artist or metadata["artist"]]))
        audio.tags.add(TALB(encoding=3, text=[metadata["album"]]))
        audio.tags.add(TRCK(encoding=3, text=[str(track_num)]))
        audio.save()
        return True
    except Exception:
        return False


# ─── Lyrics (LRCLIB) ──────────────────────────────────────────────

def _lrclib_lookup(title: str, artist: str, album: str | None = None,
                   duration: float | None = None) -> tuple[str | None, str | None]:
    """Search LRCLIB for lyrics. Returns (plain, synced) — both may be None."""
    def query(params: dict) -> list:
        url = "https://lrclib.net/api/search?" + urllib.parse.urlencode(params)
        req = urllib.request.Request(
            url,
            headers={"User-Agent": "albumdown/1.0 (+https://github.com/Karataso/albumdown)"},
        )
        with urllib.request.urlopen(req, timeout=15) as resp:
            data = json.loads(resp.read().decode("utf-8"))
        return data if isinstance(data, list) else []

    try:
        results = query({"track_name": title, "artist_name": artist})
    except Exception:
        results = []
    if not results:
        try:
            results = query({"q": f"{title} {artist}"})
        except Exception:
            return None, None

    # Score candidates — prefer duration/artist/album matches and synced lyrics
    candidates = []
    for r in results:
        if r.get("instrumental"):
            continue
        plain, synced = r.get("plainLyrics"), r.get("syncedLyrics")
        if not plain and not synced:
            continue
        score = 0
        rd = r.get("duration")
        if duration and rd:
            diff = abs(float(rd) - float(duration))
            if diff > 15:
                continue  # probably a different song
            score += 4 if diff <= 2 else (3 if diff <= 5 else 1)
        r_artist = (r.get("artistName") or "").lower()
        a = artist.lower()
        if r_artist and (r_artist == a or a in r_artist or r_artist in a):
            score += 2
        if synced:
            score += 2
        if album and r.get("albumName") and album.lower() in r["albumName"].lower():
            score += 1
        candidates.append((score, plain, synced))

    if not candidates:
        return None, None
    candidates.sort(key=lambda c: -c[0])
    return candidates[0][1], candidates[0][2]


def _embed_lyrics(filepath: Path, text: str) -> None:
    """Embed plain lyrics as an ID3 USLT frame."""
    try:
        audio = MP3(str(filepath), ID3=ID3)
    except ID3NoHeaderError:
        return
    if audio.tags is None:
        return
    audio.tags.delall("USLT")
    audio.tags.add(USLT(encoding=3, lang="eng", desc="", text=text))
    audio.save()


def _needs_lyrics(mp3_path: Path) -> bool:
    """True if the file has neither a .lrc sidecar nor embedded lyrics."""
    if mp3_path.with_suffix(".lrc").exists():
        return False
    try:
        audio = MP3(str(mp3_path), ID3=ID3)
        if audio.tags and audio.tags.getall("USLT"):
            return False
    except Exception:
        pass
    return True


def fetch_and_store_lyrics(mp3_path: Path, title: str, artist: str,
                            album: str | None, duration: float | None,
                            safe: bool = False) -> bool:
    """Fetch lyrics from LRCLIB and write them (.lrc sidecar + ID3 USLT).

    Returns True if anything was written."""
    plain, synced = _lrclib_lookup(title, artist, album, duration)
    time.sleep(2 if safe else 0.5)  # be polite to LRCLIB

    if not plain and not synced:
        return False
    if not plain and synced:
        # Derive plain text by stripping [mm:ss.xx] timestamps
        plain = re.sub(r"^\[[^\]]+\]\s*", "", synced, flags=re.MULTILINE)

    wrote = False
    if synced:
        try:
            mp3_path.with_suffix(".lrc").write_text(synced.strip() + "\n", encoding="utf-8")
            wrote = True
        except Exception:
            pass
    if plain:
        try:
            _embed_lyrics(mp3_path, plain)
            wrote = True
        except Exception:
            pass
    return wrote


# ─── Download ─────────────────────────────────────────────────────

def download_album(
    metadata: dict,
    album_dir: Path,
    quality: int = 0,
    safe: bool = False,
    cookies: str | None = None,
    lyrics: bool = False,
) -> dict:
    """Download all tracks. Returns stats dict."""
    entries = metadata["entries"]
    total = len(entries)
    stats = {"success": 0, "skipped": 0, "failed": 0, "failed_tracks": []}
    if lyrics:
        stats["lyrics"] = 0

    total_done = 0

    with Progress(
        SpinnerColumn(),
        TextColumn("[bold blue]{task.description}"),
        BarColumn(bar_width=40),
        MofNCompleteColumn(),
        TextColumn("•"),
        TimeElapsedColumn(),
        TextColumn("•"),
        TimeRemainingColumn(),
        console=console,
    ) as progress:
        dl_task = progress.add_task("Preparing...", total=total)

        for i, entry in enumerate(entries):
            track_num = i + 1

            if entry is None:
                stats["failed"] += 1
                stats["failed_tracks"].append(f"Track {track_num} (metadata unavailable)")
                progress.update(dl_task, advance=1)
                continue

            # Track number from playlist metadata (see fetch_metadata)
            pi = entry.get("playlist_index")
            if isinstance(pi, int) and pi >= 1:
                track_num = pi

            title = entry.get("title") or entry.get("fulltitle") or f"Track {track_num}"
            entry_url = entry.get("url") or entry.get("webpage_url")
            if not entry_url:
                vid_id = entry.get("id")
                if vid_id:
                    entry_url = f"https://www.youtube.com/watch?v={vid_id}"
                else:
                    stats["failed"] += 1
                    stats["failed_tracks"].append(f"{track_num:02d}. {title}")
                    progress.update(dl_task, advance=1)
                    continue

            # Per-song artist (differs from album artist on compilations)
            entry_artist = _entry_artist(entry) or metadata["artist"]

            # Check if file already exists
            safe_title = _sanitize(title)
            expected_file = album_dir / f"{track_num:02d}. {safe_title}.mp3"
            if expected_file.exists():
                stats["skipped"] += 1
                # Still backfill lyrics for existing files (so --lyrics
                # can be run on an album that's already downloaded)
                if lyrics and _needs_lyrics(expected_file):
                    progress.update(dl_task, description=f"[{track_num}/{total}] Lyrics — {title[:40]}")
                    try:
                        if fetch_and_store_lyrics(expected_file, title, entry_artist,
                                                  metadata["album"], entry.get("duration"), safe):
                            stats["lyrics"] += 1
                    except Exception:
                        pass
                progress.update(dl_task, advance=1)
                continue

            progress.update(dl_task, description=f"[{track_num}/{total}] {title[:50]}")

            # Output template: just the temp name, we'll rename after
            tmp_template = str(album_dir / f"__tmp_{track_num}__.%(ext)s")

            ydl_opts = {
                "format": "bestaudio/best",
                "outtmpl": tmp_template,
                "postprocessors": [
                    {
                        "key": "FFmpegExtractAudio",
                        "preferredcodec": "mp3",
                        "preferredquality": str(quality),
                    }
                ],
                "writethumbnail": False,
                "writeinfojson": False,
                "ignoreerrors": True,
                "no_warnings": True,
                "quiet": True,
                "noprogress": True,
                "retries": 3,
                "extractor_retries": 3,
            }

            # Cookies (authenticated session)
            if cookies:
                ydl_opts["cookiefile"] = cookies

            # Safe mode — aggressive delays to avoid bot detection
            if safe:
                ydl_opts["sleep_requests"] = 3        # 3s between metadata requests
                ydl_opts["sleep_interval"] = 5        # min 5s before each download
                ydl_opts["max_sleep_interval"] = 15   # max 15s (random between)
                ydl_opts["fragment_retries"] = 2      # fewer retries = fewer requests

            def make_hook(trk_num, trk_total, trk_title, pbar, task_id):
                def hook(d):
                    if d["status"] == "downloading":
                        total_bytes = d.get("total_bytes") or d.get("total_bytes_estimate") or 0
                        downloaded = d.get("downloaded_bytes") or 0
                        speed = d.get("speed")
                        if total_bytes and speed:
                            speed_str = f"{speed / 1_000_000:.1f}MB/s" if speed > 1_000_000 else f"{speed / 1_000:.0f}KB/s"
                            pbar.update(task_id, description=f"[{trk_num}/{trk_total}] {trk_title[:45]} • {speed_str}")
                    elif d["status"] == "finished":
                        pbar.update(task_id, description=f"[{trk_num}/{trk_total}] Converting {trk_title[:45]}...")
                return hook

            ydl_opts["progress_hooks"] = [make_hook(track_num, total, title, progress, dl_task)]

            # Retry logic with exponential backoff
            max_retries = 3
            downloaded = False

            for attempt in range(max_retries):
                try:
                    with yt_dlp.YoutubeDL(ydl_opts) as ydl:
                        ydl.download([entry_url])

                    # Find the downloaded temp file and rename it
                    tmp_mp3 = album_dir / f"__tmp_{track_num}__.mp3"
                    final_mp3 = album_dir / f"{track_num:02d}. {safe_title}.mp3"

                    if tmp_mp3.exists():
                        tmp_mp3.rename(final_mp3)
                    else:
                        # yt-dlp might have named it differently — find it
                        candidates = list(album_dir.glob(f"__tmp_{track_num}*.mp3"))
                        if candidates:
                            candidates[0].rename(final_mp3)

                    # Embed metadata
                    if final_mp3.exists():
                        embed_metadata(final_mp3, metadata, track_num, title, entry_artist)

                    stats["success"] += 1
                    downloaded = True

                    # Lyrics
                    if lyrics and final_mp3.exists():
                        progress.update(dl_task, description=f"[{track_num}/{total}] Lyrics — {title[:40]}")
                        try:
                            if fetch_and_store_lyrics(final_mp3, title, entry_artist,
                                                      metadata["album"], entry.get("duration"), safe):
                                stats["lyrics"] += 1
                        except Exception:
                            pass

                    break

                except Exception as e:
                    # Cleanup temp files before retry
                    for f in album_dir.glob(f"__tmp_{track_num}*"):
                        f.unlink(missing_ok=True)

                    if attempt < max_retries - 1:
                        # Exponential backoff: 2s, 4s, 8s...
                        wait = 2 ** (attempt + 1)
                        progress.update(
                            dl_task,
                            description=f"[{track_num}/{total}] Retry {attempt + 1}/{max_retries} in {wait}s — {title[:35]}",
                        )
                        time.sleep(wait)
                    else:
                        stats["failed"] += 1
                        stats["failed_tracks"].append(f"{track_num:02d}. {title}")

            # Delay between tracks to avoid rate limiting
            if downloaded and i < total - 1:
                if safe:
                    # Safe mode: longer, random wait with visible message
                    wait = random.uniform(6, 12)
                    progress.update(
                        dl_task,
                        description=f"⏳ Waiting {wait:.0f}s to avoid bot detection...",
                    )
                    time.sleep(wait)
                else:
                    time.sleep(1.5)

            progress.update(dl_task, advance=1)

    return stats


# ─── Summary ──────────────────────────────────────────────────────

def display_summary(stats: dict, album_dir: Path) -> None:
    console.print()
    lines = []
    if stats["success"] > 0:
        lines.append(f"[green]✓ {stats['success']} downloaded[/]")
    if stats["skipped"] > 0:
        lines.append(f"[yellow]● {stats['skipped']} skipped (already existed)[/]")
    if stats["failed"] > 0:
        lines.append(f"[red]✗ {stats['failed']} failed[/]")
    if "lyrics" in stats:
        lines.append(f"[magenta]♪ {stats['lyrics']} with lyrics[/]")

    summary = " • ".join(lines)
    console.print(summary)
    console.print(f"[dim]📁 {album_dir}[/]")

    if stats["failed_tracks"]:
        console.print("\n[bold red]Failed tracks:[/]")
        for t in stats["failed_tracks"]:
            console.print(f"  [dim]• {t}[/]")

    console.print()


# ─── Main ─────────────────────────────────────────────────────────

def _get_music_dir() -> Path:
    """Get the user's Music folder for the current platform."""
    if _IS_WINDOWS:
        # Ask Windows where the Music folder actually is
        # (handles users who moved it to another drive)
        try:
            import ctypes
            from ctypes import wintypes

            _FOLDERID_Music = ctypes.c_char_p(
                b"{4BD8D571-6D19-48D3-BE97-422220080E43}"
            )
            _SHGetKnownFolderPath = ctypes.windll.shell32.SHGetKnownFolderPath
            _SHGetKnownFolderPath.argtypes = [
                ctypes.c_char_p, wintypes.DWORD, wintypes.HANDLE,
                ctypes.POINTER(ctypes.c_wchar_p),
            ]
            _SHGetKnownFolderPath.restype = ctypes.HRESULT

            path_ptr = ctypes.c_wchar_p()
            result = _SHGetKnownFolderPath(_FOLDERID_Music, 0, 0, ctypes.byref(path_ptr))
            if result == 0:  # S_OK
                return Path(path_ptr.value)
        except Exception:
            pass
        # Fallback
        return Path.home() / "Music"
    else:
        # Linux / macOS — read XDG user-dirs config (handles localized folders)
        # e.g. ~/Musica on Spanish systems, ~/Musik on German, etc.
        try:
            xdg_file = Path.home() / ".config" / "user-dirs.dirs"
            if xdg_file.exists():
                for line in xdg_file.read_text().splitlines():
                    if line.startswith("XDG_MUSIC_DIR"):
                        # Format: XDG_MUSIC_DIR="$HOME/Música"
                        _, _, value = line.partition("=")
                        value = value.strip().strip('"')
                        value = value.replace("$HOME", str(Path.home()))
                        path = Path(value)
                        if path.is_dir():
                            return path
        except Exception:
            pass
        # Fallback
        return Path.home() / "Music"


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="albumdown",
        description="Download entire YouTube Music albums as MP3s.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "Examples:\n"
            '  albumdown "https://music.youtube.com/playlist?list=PLxxxxx"\n'
            '  albumdown "https://youtube.com/playlist?list=PLxxxxx" -o ~/Downloads\n'
            '  albumdown "https://music.youtube.com/playlist?list=PLxxxxx" --no-confirm'
        ),
    )
    parser.add_argument("url", help="YouTube Music or YouTube playlist URL")
    parser.add_argument(
        "-o", "--output",
        default=str(_get_music_dir()),
        help="Output directory (default: ~/Music)",
    )
    parser.add_argument(
        "--quality",
        type=int,
        default=0,
        choices=range(0, 11),
        metavar="0-10",
        help="MP3 quality: 0=best, 10=worst (default: 0)",
    )
    parser.add_argument(
        "--no-confirm",
        action="store_true",
        help="Skip the confirmation prompt before downloading",
    )
    parser.add_argument(
        "--safe",
        action="store_true",
        help="Slower, gentler downloads — adds delays between requests to avoid bot detection",
    )
    parser.add_argument(
        "--cookies",
        metavar="FILE",
        default=None,
        help="Path to a cookies.txt file (Netscape format) for authenticated downloads",
    )
    parser.add_argument(
        "--lyrics",
        action="store_true",
        help="Fetch lyrics from LRCLIB — writes .lrc files and embeds them in the MP3s",
    )
    return parser.parse_args()


def main():
    args = parse_args()

    if not is_album_url(args.url):
        console.print("[bold red]Error:[/] Invalid URL.")
        console.print("  Please provide a YouTube or YouTube Music playlist URL.")
        console.print("  [dim]e.g. https://music.youtube.com/playlist?list=PLxxxxx[/]")
        sys.exit(1)

    output_base = os.path.expanduser(args.output)
    if not os.path.isdir(output_base):
        console.print(f"[bold red]Error:[/] Output directory does not exist: {output_base}")
        sys.exit(1)

    # Fetch metadata
    with console.status("[bold blue]Fetching album info...", spinner="dots"):
        metadata = fetch_metadata(args.url)

    if not metadata["entries"]:
        console.print("[bold red]Error:[/] No tracks found in this playlist.")
        sys.exit(1)

    # Display tracklist
    display_tracklist(metadata)

    # Confirm
    if not args.no_confirm:
        track_count = len(metadata["entries"])
        if not Confirm.ask(
            f"[bold]Download {track_count} track{'s' if track_count != 1 else ''}?",
            default=True,
        ):
            console.print("[dim]Cancelled.[/]")
            sys.exit(0)

    # Create output directory
    album_dir = make_output_dir(metadata, output_base)
    console.print(f"[dim]📁 Saving to: {album_dir}[/]\n")

    # Download
    start = time.time()
    stats = download_album(
        metadata, album_dir,
        quality=args.quality,
        safe=args.safe,
        cookies=args.cookies,
        lyrics=args.lyrics,
    )
    elapsed = time.time() - start

    # Summary
    display_summary(stats, album_dir)
    console.print(f"[dim]Finished in {format_duration(elapsed)}[/]")


if __name__ == "__main__":
    main()
