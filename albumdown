#!/usr/bin/env python3
"""
albumdown — Download entire YouTube Music albums as MP3s.

Usage:
    albumdown <URL> [options]       (Linux/macOS)
    python albumdown <URL> [options] (Windows)

Examples:
    albumdown "https://music.youtube.com/playlist?list=PLxxxxx"
    albumdown "https://youtube.com/playlist?list=PLxxxxx" -o ~/Downloads
"""

import argparse
import json
import os
import platform
import random
import re
import subprocess
import sys
import time
import urllib.parse
import urllib.request
import venv
from pathlib import Path

# ─── Auto-bootstrapping venv ─────────────────────────────────────
# On first run, creates .venv/, installs deps, re-launches itself.
# User never sees any of this — just runs ./albumdown and it works.

_SCRIPT_DIR = Path(__file__).resolve().parent
_VENV_DIR = _SCRIPT_DIR / ".venv"
_IS_WINDOWS = platform.system() == "Windows"
_VENV_PYTHON = (
    _VENV_DIR / "Scripts" / "python.exe" if _IS_WINDOWS
    else _VENV_DIR / "bin" / "python"
)
_DEPS = ["yt-dlp", "rich", "mutagen"]


def _ensure_venv():
    """Create venv + install deps if missing, then re-exec with venv python."""
    if not _VENV_PYTHON.exists():
        print("📦 First run — setting up dependencies...")
        venv.create(str(_VENV_DIR), with_pip=True, clear=False)
        subprocess.run(
            [str(_VENV_PYTHON), "-m", "pip", "install", "--quiet", *_DEPS],
            check=True,
        )
        print("✅ Ready!\n")

    # If we're not running inside the venv, re-launch with it
    if Path(sys.executable).resolve() != _VENV_PYTHON.resolve():
        if _IS_WINDOWS:
            # os.execv doesn't work reliably on Windows — spawn and exit
            result = subprocess.run([str(_VENV_PYTHON), *sys.argv])
            sys.exit(result.returncode)
        else:
            os.execv(str(_VENV_PYTHON), [str(_VENV_PYTHON)] + sys.argv)


_ensure_venv()

# ─── Imports (guaranteed to exist after bootstrapping) ────────────

import yt_dlp
from rich.console import Console
from rich.table import Table
from rich.progress import (
    Progress,
    SpinnerColumn,
    BarColumn,
    TextColumn,
    TimeElapsedColumn,
    TimeRemainingColumn,
    MofNCompleteColumn,
)
from rich.panel import Panel
from rich.prompt import Confirm
from rich.text import Text
from rich import box
from mutagen.mp3 import MP3
