# ─── URL Validation ───────────────────────────────────────────────

YOUTUBE_PLAYLIST_RE = re.compile(
    r"(?:https?://)?(?:www\.)?"
    r"(?:music\.)?youtube\.com/(?:playlist\?list=|watch\?.*list=)"
    r"([A-Za-z0-9_-]+)"
)


ARTIST_URL_RE = re.compile(
    r"(?:https?://)?(?:www\.)?(?:music\.)?youtube\.com/"
    r"(?:"
    r"(?:channel/|c/|user/)(?P<id>[A-Za-z0-9_.-]{1,60})"
    r"|(?P<handle>@[A-Za-z0-9_.-]{1,60})"
    r")"
)


def validate_url(url: str) -> str | None:
    """Extract playlist ID from a YouTube/Music URL. Returns None if invalid."""
    m = YOUTUBE_PLAYLIST_RE.search(url)
    return m.group(1) if m else None


def classify_url(url: str) -> tuple[str, str] | None:
    """Decide what kind of thing we were handed.

    Returns ("playlist", playlist_id) for a single album,
             ("artist", identifier)   for a whole artist (channel / @handle),
             None                     for anything else."""
    playlist_id = validate_url(url)
    if playlist_id:
        return "playlist", playlist_id
    if url.strip().startswith("@"):  # bare handle: albumdown "@artist"
        return "artist", url.strip()
    m = ARTIST_URL_RE.search(url)
    if m:
        return "artist", m.group("id") or m.group("handle")
    return None


# ─── Artist Catalog (YouTube Music innertube) ─────────────────────
#
# YouTube Music has no public API, but its artist pages are served by the
# same "innertube" endpoint yt-dlp talks to for playback. We borrow yt-dlp's
# own client config (kept current by upstream) and ask it for the artist's
# "Albums" / "Singles & EPs" shelves — every release arrives with its type,
# year and the OLAK… playlist id, which is exactly what fetch_metadata()
# already knows how to download.

INNERTUBE_BROWSE_URL = "https://music.youtube.com/youtubei/v1/browse?prettyPrint=false"
YTM_INNERTUBE_CONTEXT = {
    "client": {"clientName": "WEB_REMIX", "clientVersion": "1.20250101.01.00", "hl": "en"}
}
# YouTube's own product codes for the WEB_REMIX client (stable)
YTM_CLIENT_NAME_CODE = "67"

_SHELF_HEADER_RENDERERS = (
    "musicImmersiveHeaderRenderer",
    "musicVisualHeaderRenderer",
    "musicDetailHeaderRenderer",
    "musicResponsiveHeaderRenderer",
)
_MIX_PLAYLIST_PREFIXES = ("RD", "UL", "FL", "LL")  # auto-generated mixes, not releases
_SINGLE_KINDS = ("single", "ep")
_KNOWN_RELEASE_KINDS = ("album", "single", "ep", "compilation", "live", "remix")
_RELEASE_SHELF_RE = re.compile(r"\b(albums?|singles?|eps?|discograph\w*)\b", re.IGNORECASE)


def _innertube_contexts() -> list[dict]:
    """Client configs to try, newest first — yt-dlp's own if we can reach it."""
    contexts = []
    try:
        from yt_dlp.extractor.youtube._base import INNERTUBE_CLIENTS
        ctx = INNERTUBE_CLIENTS["web_music"]["INNERTUBE_CONTEXT"]
        if isinstance(ctx, dict) and ctx.get("client", {}).get("clientName"):
            contexts.append(ctx)
    except Exception:
        pass
    contexts.append(YTM_INNERTUBE_CONTEXT)
    return contexts


def _http_opener(cookies: str | None = None) -> urllib.request.OpenerDirector:
    """urllib opener, optionally carrying the user's cookies.txt — so
    --cookies covers artist-page reads too, not just the downloads."""
    if not cookies:
        return urllib.request.build_opener()
    jar = http.cookiejar.MozillaCookieJar(cookies)
    try:
        jar.load(ignore_discard=True, ignore_expires=True)
    except Exception:
        return urllib.request.build_opener()
    return urllib.request.build_opener(urllib.request.HTTPCookieProcessor(jar))


def _innertube_browse(
    browse_id: str, params: str | None = None, opener=None
) -> dict | None:
    """Fetch a YouTube Music page (artist channel, album, "see all" grid).

    Returns the parsed response, or None when YouTube shrugs at us."""
    opener = opener or _http_opener()
    tried_versions = set()
    for ctx in _innertube_contexts():
        version = ctx["client"].get("clientVersion")
        if version in tried_versions:  # identical configs — don't repeat ourselves
            continue
        tried_versions.add(version)

        body = {"context": ctx, "browseId": browse_id}
        if params:
            body["params"] = params
        headers = {
            "Content-Type": "application/json",
            "User-Agent": "Mozilla/5.0",
            "X-Youtube-Client-Name": YTM_CLIENT_NAME_CODE,
            "X-Youtube-Client-Version": version or "",
        }
        try:
            req = urllib.request.Request(
                INNERTUBE_BROWSE_URL,
                data=json.dumps(body).encode("utf-8"),
                headers=headers,
            )
            with opener.open(req, timeout=25) as resp:
                data = json.loads(resp.read().decode("utf-8"))
            if isinstance(data, dict) and data:
                return data
        except Exception:
            continue
    return None


def resolve_artist_channel(url: str, opener=None) -> str | None:
    """Turn an artist URL into a UC… channel id.

    Direct channel links are already ids; @handles and custom URLs need one
    cheap fetch of the channel page (music.youtube.com is a JS shell, so we
    ask www.youtube.com instead)."""
    m = re.search(r"youtube\.com/channel/(UC[\w-]{22})", url)
    if m:
        return m.group(1)

    target = url.strip()
    if target.startswith("@"):
        target = "https://www.youtube.com/" + target
    else:
        target = re.sub(r"^https?://music\.youtube\.com", "https://www.youtube.com", target)
        if not target.startswith("http"):
            target = "https://www.youtube.com/" + target

    try:
        req = urllib.request.Request(target, headers={"User-Agent": "Mozilla/5.0"})
        with (opener or _http_opener()).open(req, timeout=20) as resp:
            html = resp.read().decode("utf-8", "ignore")
    except Exception:
        return None

    for pattern in (
        r'<link rel="canonical" href="https://www\.youtube\.com/channel/(UC[\w-]{22})"',
        r'"externalId":"(UC[\w-]{22})"',
        r'"channelId":"(UC[\w-]{22})"',
    ):
        m = re.search(pattern, html)
        if m:
            return m.group(1)
    return None


def _walk(node):
    """Depth-first walk over an innertube JSON tree, yielding every dict."""
    if isinstance(node, dict):
        yield node
        for value in node.values():
            yield from _walk(value)
    elif isinstance(node, list):
        for value in node:
            yield from _walk(value)


def _runs_text(node) -> str:
    """Text of a `{"runs": [...]}` / `{"simpleText": ...}` node."""
    if isinstance(node, dict):
        if isinstance(node.get("runs"), list):
            return "".join(r.get("text", "") for r in node["runs"])
        return node.get("simpleText") or ""
    return ""


def _playlist_id_in(node) -> str | None:
    """First real playlist id inside a node — skips auto-generated mixes
    (RD…/UL…), which would download a shuffle instead of the release."""
    if node is None:
        return None
    for d in _walk(node):
        endpoint = d.get("watchPlaylistEndpoint")
        if not isinstance(endpoint, dict):
            nav = d.get("navigationEndpoint")
            endpoint = nav.get("watchPlaylistEndpoint") if isinstance(nav, dict) else None
        if isinstance(endpoint, dict):
            playlist_id = endpoint.get("playlistId")
            if isinstance(playlist_id, str) and not playlist_id.startswith(_MIX_PLAYLIST_PREFIXES):
                return playlist_id
    return None


def _release_kind(subtitle: str, shelf_title: str) -> str:
    """Album / single / EP / compilation… from the item's subtitle, falling
    back to the shelf it came from ('Albums' vs 'Singles & EPs')."""
    head = subtitle.split("•")[0].strip().lower() if subtitle else ""
    if head in _KNOWN_RELEASE_KINDS:
        return head
    shelf = (shelf_title or "").lower()
    if "album" in shelf:
        return "album"
    if "single" in shelf or re.search(r"\bep", shelf):
        return "single"
    return "album"


def _release_year(subtitle: str) -> str:
    m = re.search(r"\b((?:19|20)\d{2})\b", subtitle or "")
    return m.group(1) if m else ""


def _release_from_item(item: dict, shelf_title: str) -> dict | None:
    """Pull a release out of a shelf/grid card (two kinds of renderer exist)."""
    two_row = item.get("musicTwoRowItemRenderer")
    responsive = item.get("musicResponsiveListItemRenderer")
    browse_id = None
    if isinstance(two_row, dict):
        title = _runs_text(two_row.get("title"))
        subtitle = _runs_text(two_row.get("subtitle"))
        endpoint = two_row.get("navigationEndpoint") or {}
        browse_id = (endpoint.get("browseEndpoint") or {}).get("browseId")
    elif isinstance(responsive, dict):
        columns = [_runs_text(c.get("text")) for c in responsive.get("flexColumns") or []]
        title = columns[0] if columns else ""
        subtitle = " • ".join(c for c in columns[1:] if c)
    else:
        return None

    if not title:
        return None
    thumbnail = None
    for d in _walk(item):
        thumbs = ((d.get("musicThumbnailRenderer") or {}).get("thumbnail") or {}).get("thumbnails")
        if thumbs:
            thumbnail = thumbs[-1].get("url")  # largest variant
            break

    return {
        "title": title,
        "kind": _release_kind(subtitle, shelf_title),
        "year": _release_year(subtitle),
        "playlist_id": _playlist_id_in(item),
        "browse_id": browse_id,
        "thumbnail": thumbnail,
    }


def _release_shelves(page: dict) -> list[dict]:
    """Every carousel shelf on an artist page: title, 'see all' endpoint, items."""
    shelves = []
    for d in _walk(page):
        shelf = d.get("musicCarouselShelfRenderer")
        if not isinstance(shelf, dict):
            continue
        header = shelf.get("header") or {}
        header = header.get("musicCarouselShelfBasicHeaderRenderer") or header
        title_node = header.get("title")
        title = _runs_text(title_node)
        runs = title_node.get("runs") if isinstance(title_node, dict) else None
        endpoint = (runs[0].get("navigationEndpoint") or {}) if runs else {}
        browse = endpoint.get("browseEndpoint") or {}
        shelves.append({
            "title": title,
            "browse_id": browse.get("browseId"),
            "params": browse.get("params"),
            "items": [c for c in (shelf.get("contents") or []) if isinstance(c, dict)],
        })
    return shelves


def fetch_artist_catalog(url: str, cookies: str | None = None) -> dict | None:
    """Read a YouTube Music artist page: artist name + every release.

    Returns {"artist": str, "releases": [...]} or None if the page can't be
    read (bad URL, bot check, network hiccup)."""
    opener = _http_opener(cookies)
    channel = resolve_artist_channel(url, opener)
    if not channel:
        return None
    page = _innertube_browse(channel, opener=opener)
    if not page:
        return None

    # Artist name lives in the page header (immersive for real artists)
    artist = ""
    for d in _walk(page):
        for key in _SHELF_HEADER_RENDERERS:
            if isinstance(d.get(key), dict):
                artist = _runs_text(d[key].get("title"))
                if artist:
                    break
        if artist:
            break

    releases: list[dict] = []
    seen_titles: set[str] = set()
    seen_playlists: set[str] = set()
    for shelf in _release_shelves(page):
        if not _RELEASE_SHELF_RE.search(shelf["title"] or ""):
            continue  # Videos / Featured on / Playlists / Fans might also like…
        items = shelf["items"]
        if shelf["browse_id"]:
            # The shelf on the artist page is a teaser — follow "see all" for
            # the complete album/singles list.
            full = _innertube_browse(shelf["browse_id"], shelf["params"], opener=opener)
            if full:
                items = [
                    d for d in _walk(full)
                    if "musicTwoRowItemRenderer" in d or "musicResponsiveListItemRenderer" in d
                ] or items

        for raw in items:
            release = _release_from_item(raw, shelf["title"])
            if not release:
                continue
            # Shelves overlap: the same release often shows up as an album
            # and again under singles, sometimes under two playlist ids.
            # One row per title+year keeps the picker honest.
            title_key = f'{release["title"].casefold()}|{release["year"]}'
            if title_key in seen_titles:
                continue
            if release["playlist_id"] and release["playlist_id"] in seen_playlists:
                continue
            if not release["playlist_id"] and release["browse_id"]:
                # Rare: card without a direct playlist — open the album page
                album_page = _innertube_browse(release["browse_id"], opener=opener)
                release["playlist_id"] = _playlist_id_in(album_page)
            if not release["playlist_id"]:
                continue
            seen_titles.add(title_key)
            seen_playlists.add(release["playlist_id"])
            releases.append(release)

    return {"artist": artist or "Unknown Artist", "channel": channel, "releases": releases}


# ─── Metadata Extraction ──────────────────────────────────────────

def fetch_metadata(url: str, flat: bool = False, fatal: bool = True) -> dict | None:
    """Fetch playlist metadata without downloading anything.

    flat=True  → one request for the whole playlist instead of one per track.
                 Loses the per-entry tags, so the caller must supply album and
                 artist names (the discography catalog already has them).
    fatal=True → bail out of the program on failure (single-album mode);
                 return None instead so a full-artist run can skip it."""
    ydl_opts = {
        "quiet": True,
        "no_warnings": True,
        "extract_flat": "in_playlist" if flat else False,
        "skip_download": True,
    }

    with yt_dlp.YoutubeDL(ydl_opts) as ydl:
        try:
            info = ydl.extract_info(url, download=False)
        except yt_dlp.utils.DownloadError as e:
            if not fatal:
                return None
            console.print("[bold red]Error:[/] Could not fetch playlist info.")
            console.print(f"[dim]{e}[/]")
            sys.exit(1)

    if not info:
        if not fatal:
            return None
        console.print("[bold red]Error:[/] No metadata returned.")
        sys.exit(1)

    # Single video — treat as 1-track "album"
    if info.get("_type") == "video" or not info.get("entries"):
        entries = [info]
        album_name = _clean_album(info.get("album") or info.get("title"))
        artist = _entry_artist(info) or _clean_artist(
            info.get("uploader")
            or info.get("channel")
            or "Unknown Artist"
        )
    else:
        entries = list(info.get("entries", []))
        valid = [e for e in entries if e is not None]

        if flat:
            # One request, no per-entry tags: the playlist's own title and
            # uploader stand in until the discography catalog overrides them.
            # _clean_playlist_title strips YouTube's "Album - " prefixes.
            album_name = _clean_playlist_title(info.get("title", ""))
            artist = _clean_artist(
                info.get("uploader") or info.get("channel") or "Unknown Artist"
            )
        else:
            # Album: the per-entry tag is cleaner than the playlist title
            # (YouTube Music titles often come prefixed: "Album - Lámina Once")
            album_name = ""
            for e in valid:
                if e.get("album"):
                    album_name = _clean_album(e["album"])
                    break
            if not album_name:
                album_name = _clean_playlist_title(info.get("title", "Unknown Album"))

            # Artist: per-entry tag first, then playlist uploader/channel
            artist = ""
            for e in valid:
                artist = _entry_artist(e)
                if artist:
                    break
            if not artist:
                artist = _clean_artist(
                    info.get("uploader")
                    or info.get("channel")
                    or ""
                )
            # Fallback: try first entry's uploader
            if not artist or artist.lower() in ("unknown artist", ""):
                first = valid[0] if valid else {}
                artist = _clean_artist(
                    first.get("uploader")
                    or first.get("channel")
                    or "Unknown Artist"
                )

            # The catalog merges distributor feeds that disagree on
            # capitalization ("El Cuarteto De Nos" vs "El Cuarteto de Nos").
            # Unify to the most common spelling within this album;
            # make_output_dir() handles the cross-album case.
            canonical = _most_common_case([a for a in (_entry_artist(e) for e in valid) if a])
            if canonical and canonical.casefold() == artist.casefold():
                artist = canonical
                for e in valid:
                    _rewrite_entry_artist(e, canonical)

    valid_entries = [e for e in entries if e is not None]

    # YouTube Music has no track-number field (its "track" key holds the
    # song title) — the order lives in playlist_index. Normalize it so
    # display, filenames and the ID3 TRCK tag all agree.
    for idx, e in enumerate(valid_entries, 1):
        pi = e.get("playlist_index")
        if not isinstance(pi, int) or pi < 1:
            e["playlist_index"] = idx

    # Cover image candidates, best first. The playlist's own thumbnail is
    # the real album cover — prefer it over per-video thumbnails, which are
    # often screwey video frames with text overlays. Keep every candidate:
    # the unsigned maxres URL often 404s while signed smaller ones work.
    cover_urls: list[str] = []
    tlist = [t for t in (info.get("thumbnails") or []) if t.get("url")]
    for t in sorted(tlist, key=lambda t: t.get("width") or 0, reverse=True):
        if t["url"] not in cover_urls:
            cover_urls.append(t["url"])
    best = info.get("thumbnail")
    if best and best not in cover_urls:
        cover_urls.append(best)

    return {
        "album": album_name,
        "artist": artist,
        "entries": valid_entries,
        "cover_urls": cover_urls,
        "url": url,
    }


def _clean_artist(name: str) -> str:
    """Strip common suffixes that YouTube adds to artist names."""
    if not name:
        return "Unknown Artist"
    # Remove "- Topic", "- Album", "- Single" suffixes
    name = re.sub(r"\s*-\s*(Topic|Album|Single|VEVO)$", "", name, flags=re.IGNORECASE)
    name = name.strip()
    return name or "Unknown Artist"


def _clean_album(name: str) -> str:
    """Clean album name."""
    if not name:
        return "Unknown Album"
    return name.strip()


def _clean_playlist_title(name: str) -> str:
    """Strip the prefixes YouTube Music puts on playlist titles ('Album - X')."""
    name = (name or "").strip()
    name = re.sub(r"^(full\s+album|album|lp|ep|single)\s*[-–—:]\s*", "", name, flags=re.IGNORECASE)
    return name.strip() or "Unknown Album"


def _entry_artist(entry: dict) -> str:
    """Per-song artist from its own metadata ('' if unavailable)."""
    artists = entry.get("artists")
    if isinstance(artists, list) and artists and artists[0]:
        return _clean_artist(str(artists[0]))
    a = entry.get("artist") or entry.get("creator")
    if a:
        return _clean_artist(str(a).split(",")[0].strip())
    return ""


def _most_common_case(names: list[str]) -> str | None:
    """Most frequent capitalization among case-insensitive variants."""
    groups: dict[str, list[str]] = {}
    for n in names:
        if n:
            groups.setdefault(n.casefold(), []).append(n)
    if not groups:
        return None
    # Most-occurring spelling group wins; ties go to the group seen first,
    # and inside it to the variant seen first — fully deterministic
    best = max(groups.values(), key=len)
    return max(best, key=lambda v: (best.count(v), -best.index(v)))


def _rewrite_entry_artist(entry: dict, canonical: str) -> None:
    """Rewrite case-variant artist fields in an entry to the canonical spelling."""
    key = canonical.casefold()
    arts = entry.get("artists")
    if isinstance(arts, list):
        entry["artists"] = [
            canonical if isinstance(a, str) and a.casefold() == key else a
            for a in arts
        ]
    for f in ("artist", "creator"):
        v = entry.get(f)
        if isinstance(v, str):
            head = v.split(",")[0]
            if head.strip().casefold() == key:
                entry[f] = canonical + v[len(head):]


def _apply_artist_case(metadata: dict, canonical: str) -> None:
    """Unify artist casing in metadata and every entry (folder name AND
    embedded tags must agree, or players still split the artist)."""
    metadata["artist"] = canonical
    for e in metadata.get("entries") or []:
        _rewrite_entry_artist(e, canonical)


# ─── Display ──────────────────────────────────────────────────────

def format_duration(seconds: int | float | None) -> str:
    if not seconds:
        return "??:??"
    total = int(seconds)
    h, remainder = divmod(total, 3600)
    m, s = divmod(remainder, 60)
    if h > 0:
        return f"{h}:{m:02d}:{s:02d}"
    return f"{m}:{s:02d}"


def display_tracklist(metadata: dict) -> None:
    album = metadata["album"]
    artist = metadata["artist"]
    entries = metadata["entries"]

    total_duration = sum(e.get("duration") or 0 for e in entries)
    track_count = len(entries)

    header = Text()
    header.append("🎵 ", style="bold")
    header.append(artist, style="bold cyan")
    header.append(" — ", style="dim")
    header.append(album, style="bold white")
    header.append(
        f"\n   {track_count} track{'s' if track_count != 1 else ''} • {format_duration(total_duration)} total",
        style="dim",
    )

    console.print()
    console.print(Panel(header, border_style="blue", box=box.ROUNDED))

    table = Table(box=box.SIMPLE_HEAVY, show_header=True, header_style="bold green", padding=(0, 1))
    table.add_column("#", style="dim", width=4, justify="right")
    table.add_column("Title", style="white", ratio=3)
    table.add_column("Duration", style="dim", justify="right")

    for i, entry in enumerate(entries, 1):
        title = entry.get("title") or entry.get("fulltitle") or f"Track {i}"
        duration = format_duration(entry.get("duration"))
        num = entry.get("playlist_index")
        if not isinstance(num, int):
            num = i
        table.add_row(f"{num:02d}", title, duration)

    console.print(table)
    console.print()


# ─── Release Picker (full-artist mode) ────────────────────────────

def display_release_catalog(catalog: dict, include_singles: bool) -> list[dict]:
    """Show the discography and return the releases worth offering."""
    releases = catalog["releases"]
    albums = [r for r in releases if r["kind"] not in _SINGLE_KINDS]
    singles = [r for r in releases if r["kind"] in _SINGLE_KINDS]
    shown = releases if include_singles else albums

    header = Text()
    header.append("🎤 ", style="bold")
    header.append(catalog["artist"], style="bold cyan")
    header.append(" — full discography", style="dim")
    header.append(
        f"\n   {len(albums)} album{'s' if len(albums) != 1 else ''}"
        f" • {len(singles)} single{'' if len(singles) == 1 else 's'}"
        f"{'/EP' if len(singles) == 1 else ' & EPs'}"
        f" • {len(shown)} shown",
        style="dim",
    )
    console.print()
    console.print(Panel(header, border_style="blue", box=box.ROUNDED))

    table = Table(box=box.SIMPLE_HEAVY, show_header=True, header_style="bold green", padding=(0, 1))
    table.add_column("#", style="dim", width=4, justify="right")
    table.add_column("Type", style="magenta", width=13)
    table.add_column("Year", style="dim", width=5, justify="right")
    table.add_column("Release", style="white", ratio=3)

    for i, release in enumerate(shown, 1):
        kind = "EP" if release["kind"] == "ep" else release["kind"].title()
        table.add_row(f"{i:02d}", kind, release["year"] or "—", release["title"])
    console.print(table)
    console.print()

    if singles and not include_singles:
        console.print(
            f"[dim]{len(singles)} singles & EPs hidden — add --include-singles to pick them too[/]"
        )
        console.print()

    return shown


def _parse_selection(text: str, count: int) -> list[int] | None:
    """'1-4, 7' → [1,2,3,4,7] · 'all'/'' → everything · 'q' → None (quit)."""
    raw = (text or "").strip().lower()
    if raw in ("", "all", "a", "*"):
        return list(range(1, count + 1))
    if raw in ("q", "quit", "none", "n", "0"):
        return None

    picked: set[int] = set()
    for part in raw.replace(" ", "").split(","):
        if not part:
            continue
        lo, _, hi = part.partition("-")
        first = int(lo)  # ValueError → caller re-asks
        last = int(hi) if _ else first
        if not (1 <= first <= last <= count):
            raise ValueError(part)
        picked.update(range(first, last + 1))
    if not picked:
        raise ValueError(text)
    return sorted(picked)


def ask_release_selection(count: int) -> list[int]:
    """Prompt until the user picks 1-based indices (empty = none chosen)."""
    while True:
        answer = Prompt.ask(
            "[bold]Which releases?[/] "
            "[dim](e.g. 1-4, 7, all · Enter = all · q = quit)[/]",
            default="all",
        )
        try:
            selection = _parse_selection(answer, count)
        except ValueError:
            console.print("[red]Couldn't read that — use numbers or ranges like 1-3.[/]")
            continue
        if selection is None:
            console.print("[dim]Cancelled.[/]")
            sys.exit(0)
        return selection


# ─── File System ──────────────────────────────────────────────────

def _sanitize(name: str) -> str:
    name = re.sub(r'[\\/:*?"<>|]', "_", name)
    name = re.sub(r"_+", "_", name).strip("_. ")
    return name or "Unknown"


def _merge_artist_folder(metadata: dict, base: Path) -> None:
    """Merge case-variant artist folders. YouTube's catalog disagrees on
    capitalization between albums, so previous runs may have created
    "El Cuarteto de Nos" while this run wants "...De Nos". Adopt the
    existing folder's spelling — in the folder name AND the embedded
    tags — so players see ONE artist, not two. Creates nothing."""
    artist = metadata.get("artist") or ""
    if not base.is_dir():
        return
    key = artist.casefold()
    for p in sorted(base.iterdir()):
        if p.is_dir() and p.name.casefold() == key:
            if p.name != artist:
                _apply_artist_case(metadata, p.name)
            return


def make_output_dir(metadata: dict, output_base: str) -> Path:
    """Create ~/Music/{Artist}/{Album}/ structure."""
    artist = _sanitize(metadata["artist"])
    album = _sanitize(metadata["album"])
    album_dir = Path(output_base) / artist / album
    album_dir.mkdir(parents=True, exist_ok=True)
    return album_dir


# ─── Metadata Embedding ───────────────────────────────────────────

def embed_metadata(filepath: Path, metadata: dict, track_num: int, title: str,
                    artist: str | None = None) -> bool:
    """Embed ID3 tags into an MP3 file. Returns True on success."""
    try:
        try:
            audio = MP3(str(filepath), ID3=ID3)
        except ID3NoHeaderError:
            audio = MP3(str(filepath))
            audio.add_tags()

        audio.tags.add(TIT2(encoding=3, text=[title]))
        audio.tags.add(TPE1(encoding=3, text=[artist or metadata["artist"]]))
        audio.tags.add(TALB(encoding=3, text=[metadata["album"]]))
        audio.tags.add(TRCK(encoding=3, text=[str(track_num)]))
        audio.save()
        return True
    except Exception:
        return False


# ─── Lyrics (LRCLIB) ──────────────────────────────────────────────

def _lrclib_lookup(title: str, artist: str, album: str | None = None,
                   duration: float | None = None) -> tuple[str | None, str | None]:
    """Search LRCLIB for lyrics. Returns (plain, synced) — both may be None."""
    def query(params: dict) -> list:
        url = "https://lrclib.net/api/search?" + urllib.parse.urlencode(params)
        req = urllib.request.Request(
            url,
            headers={"User-Agent": "albumdown/1.0 (+https://github.com/Karataso/albumdown)"},
        )
        with urllib.request.urlopen(req, timeout=15) as resp:
            data = json.loads(resp.read().decode("utf-8"))
        return data if isinstance(data, list) else []

    try:
        results = query({"track_name": title, "artist_name": artist})
    except Exception:
        results = []
    if not results:
        try:
            results = query({"q": f"{title} {artist}"})
        except Exception:
            return None, None

    # Score candidates — prefer duration/artist/album matches and synced lyrics
    candidates = []
    for r in results:
        if r.get("instrumental"):
            continue
        plain, synced = r.get("plainLyrics"), r.get("syncedLyrics")
        if not plain and not synced:
            continue
        score = 0
        rd = r.get("duration")
        if duration and rd:
            diff = abs(float(rd) - float(duration))
            if diff > 15:
                continue  # probably a different song
            score += 4 if diff <= 2 else (3 if diff <= 5 else 1)
        r_artist = (r.get("artistName") or "").lower()
        a = artist.lower()
        if r_artist and (r_artist == a or a in r_artist or r_artist in a):
            score += 2
        if synced:
            score += 2
        if album and r.get("albumName") and album.lower() in r["albumName"].lower():
            score += 1
        candidates.append((score, plain, synced))

    if not candidates:
        return None, None
    candidates.sort(key=lambda c: -c[0])
    return candidates[0][1], candidates[0][2]


def _embed_lyrics(filepath: Path, text: str) -> None:
    """Embed plain lyrics as an ID3 USLT frame."""
    try:
        audio = MP3(str(filepath), ID3=ID3)
    except ID3NoHeaderError:
        return
    if audio.tags is None:
        return
    audio.tags.delall("USLT")
    audio.tags.add(USLT(encoding=3, lang="eng", desc="", text=text))
    audio.save()


def _needs_lyrics(mp3_path: Path) -> bool:
    """True if the file has neither a .lrc sidecar nor embedded lyrics."""
    if mp3_path.with_suffix(".lrc").exists():
        return False
    try:
        audio = MP3(str(mp3_path), ID3=ID3)
        if audio.tags and audio.tags.getall("USLT"):
            return False
    except Exception:
        pass
    return True


def fetch_and_store_lyrics(mp3_path: Path, title: str, artist: str,
                            album: str | None, duration: float | None,
                            safe: bool = False) -> bool:
    """Fetch lyrics from LRCLIB and write them (.lrc sidecar + ID3 USLT).

    Returns True if anything was written."""
    plain, synced = _lrclib_lookup(title, artist, album, duration)
    time.sleep(2 if safe else 0.5)  # be polite to LRCLIB

    if not plain and not synced:
        return False
    if not plain and synced:
        # Derive plain text by stripping [mm:ss.xx] timestamps
        plain = re.sub(r"^\[[^\]]+\]\s*", "", synced, flags=re.MULTILINE)

    wrote = False
    if synced:
        try:
            mp3_path.with_suffix(".lrc").write_text(synced.strip() + "\n", encoding="utf-8")
            wrote = True
        except Exception:
            pass
    if plain:
        try:
            _embed_lyrics(mp3_path, plain)
            wrote = True
        except Exception:
            pass
    return wrote


# ─── Cover Art ────────────────────────────────────────────────────

def _download_image(url: str) -> bytes | None:
    """Download an image. Returns bytes or None."""
    if not url:
        return None
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
        with urllib.request.urlopen(req, timeout=20) as resp:
            data = resp.read()
        return data or None
    except Exception:
        return None


def _image_normalize(data: bytes) -> tuple[bytes, str] | None:
    """Return (bytes, mime) — JPEG/PNG pass through, anything else
    (webp, avif...) is converted to JPEG via ffmpeg."""
    if data[:2] == b"\xff\xd8":
        return data, "image/jpeg"
    if data[:8] == b"\x89PNG\r\n\x1a\n":
        return data, "image/png"
    try:
        with tempfile.TemporaryDirectory() as td:
            src = Path(td) / "art.in"
            dst = Path(td) / "art.jpg"
            src.write_bytes(data)
            subprocess.run(
                ["ffmpeg", "-loglevel", "error", "-y", "-i", str(src),
                 "-frames:v", "1", str(dst)],
                check=True, capture_output=True, timeout=30,
            )
            return dst.read_bytes(), "image/jpeg"
    except Exception:
        return None


def embed_art(filepath: Path, image: bytes, mime: str = "image/jpeg") -> bool:
    """Embed cover art as an ID3 APIC frame. Skips if art already present.
    Returns True if art was added."""
    try:
        try:
            audio = MP3(str(filepath), ID3=ID3)
        except ID3NoHeaderError:
            audio = MP3(str(filepath))
            audio.add_tags()
        if audio.tags is None:
            return False
        if audio.tags.getall("APIC"):
            return False
        audio.tags.add(APIC(encoding=3, mime=mime, type=3, desc="Cover", data=image))
        audio.save()
        return True
    except Exception:
        return False


# ─── Failure Handling ─────────────────────────────────────────────
#
# YouTube fails in three very different ways, and retrying them all the
# same way is exactly why you end up re-running the program by hand:
#
#   block      403 / "Sign in to confirm you're not a bot". A transient
#              bot check — waiting a little and trying again usually works
#              (that's what re-running already proves), but only a few
#              times: past that we're just hammering.
#   gone       private, deleted, geo-blocked. No amount of waiting will
#              resurrect it, so fail the track and move on immediately.
#   transient  timeouts, connection resets, 5xx. Normal short backoff.

_BLOCK_MARKERS = (
    "sign in to confirm",
    "not a bot",
    "403: forbidden",
    "http error 403",
    "http error 429",
    "too many requests",
    "cookies are no longer valid",
    "please sign in",
    "login required",
)
_GONE_MARKERS = (
    "video unavailable",
    "is unavailable",
    "video is private",
    "has been removed",
    "available in your country",
    "account associated with this video",
    "uploader has closed",
    "no longer available",
    "confirm your age",
    "is not available",
    "copyright",
)

_RETRY_POLICY = {
    "block": {"tries": 3, "base": 30, "cap": 120},   # 30s → 60s → 120s
    "transient": {"tries": 6, "base": 2, "cap": 30},  # 2s → … → 30s
    "gone": {"tries": 0, "base": 0, "cap": 0},
}
_FAILURE_LABEL = {
    "block": "403 — YouTube is checking us",
    "transient": "network hiccup",
}
_FAILURE_NOTE = {
    "block": "blocked, try again in a bit",
    "gone": "unavailable",
    "transient": "gave up after retries",
}


def classify_failure(error: Exception) -> str:
    """Sort an error into 'block' | 'gone' | 'transient' (see above)."""
    text = str(error).lower()
    if any(marker in text for marker in _BLOCK_MARKERS):
        return "block"
    if any(marker in text for marker in _GONE_MARKERS):
        return "gone"
    return "transient"


def _retry_wait(kind: str, attempt: int) -> int:
    """Seconds to wait before retry `attempt` (0-based) of that kind."""
    policy = _RETRY_POLICY[kind]
    return min(policy["base"] * (2 ** attempt), policy["cap"])


# ─── Download ─────────────────────────────────────────────────────

def _fetch_track(
    entry_url: str,
    ydl_opts: dict,
    album_dir: Path,
    track_num: int,
    safe_title: str,
    metadata: dict,
    title: str,
    entry_artist: str,
) -> Path:
    """Download, convert and tag one track — returns its final path.

    Raises on any failure, *including* the silent one: yt-dlp can report an
    error and still return normally, so the file on disk is the only proof
    of success we trust. Callers classify the error and decide what to do."""
    with yt_dlp.YoutubeDL(ydl_opts) as ydl:
        ydl.download([entry_url])

    final_mp3 = album_dir / f"{track_num:02d}. {safe_title}.mp3"
    tmp_mp3 = album_dir / f"__tmp_{track_num}__.mp3"

    if tmp_mp3.exists():
        tmp_mp3.rename(final_mp3)
    else:
        # yt-dlp might have named it differently — find it
        candidates = list(album_dir.glob(f"__tmp_{track_num}*.mp3"))
        if candidates:
            candidates[0].rename(final_mp3)

    if not final_mp3.exists():
        raise RuntimeError("yt-dlp finished without producing a file")

    embed_metadata(final_mp3, metadata, track_num, title, entry_artist)
    return final_mp3


def download_album(
    metadata: dict,
    album_dir: Path,
    quality: int = 0,
    safe: bool = False,
    cookies: str | None = None,
    lyrics: bool = False,
    art: bool = True,
) -> dict:
    """Download all tracks. Returns stats dict."""
    entries = metadata["entries"]
    total = len(entries)
    stats = {"success": 0, "skipped": 0, "failed": 0, "failed_tracks": []}
    if lyrics:
        stats["lyrics"] = 0
    if art:
        stats["art"] = 0

    # Album cover art — downloaded once, shared by every track so the
    # whole album gets one clean, consistent cover. Candidates run
    # best-first; the top one sometimes 404s, so keep going down the list.
    album_art: tuple[bytes, str] | None = None
    if art and metadata.get("cover_urls"):
        with console.status("[bold blue]Fetching album art...", spinner="dots"):
            for u in metadata["cover_urls"]:
                raw = _download_image(u)
                norm = _image_normalize(raw) if raw else None
                if norm:
                    album_art = norm
                    break

    total_done = 0
    # Set the first time YouTube throws a 403 at us — everything after that
    # runs at a gentler pace instead of asking for trouble again.
    block_seen = False

    with Progress(
        SpinnerColumn(),
        TextColumn("[bold blue]{task.description}"),
        BarColumn(bar_width=40),
        MofNCompleteColumn(),
        TextColumn("•"),
        TimeElapsedColumn(),
        TextColumn("•"),
        TimeRemainingColumn(),
        console=console,
    ) as progress:
        dl_task = progress.add_task("Preparing...", total=total)

        for i, entry in enumerate(entries):
            track_num = i + 1

            if entry is None:
                stats["failed"] += 1
                stats["failed_tracks"].append(f"Track {track_num} (metadata unavailable)")
                progress.update(dl_task, advance=1)
                continue

            # Track number from playlist metadata (see fetch_metadata)
            pi = entry.get("playlist_index")
            if isinstance(pi, int) and pi >= 1:
                track_num = pi

            title = entry.get("title") or entry.get("fulltitle") or f"Track {track_num}"
            entry_url = entry.get("url") or entry.get("webpage_url")
            if not entry_url:
                vid_id = entry.get("id")
                if vid_id:
                    entry_url = f"https://www.youtube.com/watch?v={vid_id}"
                else:
                    stats["failed"] += 1
                    stats["failed_tracks"].append(f"{track_num:02d}. {title}")
                    progress.update(dl_task, advance=1)
                    continue

            # Per-song artist (differs from album artist on compilations)
            entry_artist = _entry_artist(entry) or metadata["artist"]

            # Check if file already exists
            safe_title = _sanitize(title)
            expected_file = album_dir / f"{track_num:02d}. {safe_title}.mp3"
            if expected_file.exists():
                stats["skipped"] += 1
                # Still backfill lyrics for existing files (so --lyrics
                # can be run on an album that's already downloaded)
                if lyrics and _needs_lyrics(expected_file):
                    progress.update(dl_task, description=f"[{track_num}/{total}] Lyrics — {title[:40]}")
                    try:
                        if fetch_and_store_lyrics(expected_file, title, entry_artist,
                                                  metadata["album"], entry.get("duration"), safe):
                            stats["lyrics"] += 1
                    except Exception:
                        pass
                # Backfill cover art for existing files too
                if art and album_art and embed_art(expected_file, album_art[0], album_art[1]):
                    stats["art"] += 1
                progress.update(dl_task, advance=1)
                continue

            progress.update(dl_task, description=f"[{track_num}/{total}] {title[:50]}")

            # Output template: just the temp name, we'll rename after
            tmp_template = str(album_dir / f"__tmp_{track_num}__.%(ext)s")

            ydl_opts = {
                "format": "bestaudio/best",
                "outtmpl": tmp_template,
                "postprocessors": [
                    {
                        "key": "FFmpegExtractAudio",
                        "preferredcodec": "mp3",
                        "preferredquality": str(quality),
                    }
                ],
                "writethumbnail": False,
                "writeinfojson": False,
                # Failures MUST raise. With ignoreerrors yt-dlp only prints
                # "ERROR: …" and returns 0, which used to make the retry loop
                # below count a success for a file that never existed.
                "ignoreerrors": False,
                "no_warnings": True,
                "quiet": True,
                "noprogress": True,
                "retries": 3,
                "extractor_retries": 3,
            }

            # Cookies (authenticated session)
            if cookies:
                ydl_opts["cookiefile"] = cookies

            # Safe mode — aggressive delays to avoid bot detection
            if safe:
                ydl_opts["sleep_requests"] = 3        # 3s between metadata requests
                ydl_opts["sleep_interval"] = 5        # min 5s before each download
                ydl_opts["max_sleep_interval"] = 15   # max 15s (random between)
                ydl_opts["fragment_retries"] = 2      # fewer retries = fewer requests

            def make_hook(trk_num, trk_total, trk_title, pbar, task_id):
                def hook(d):
                    if d["status"] == "downloading":
                        total_bytes = d.get("total_bytes") or d.get("total_bytes_estimate") or 0
                        downloaded = d.get("downloaded_bytes") or 0
                        speed = d.get("speed")
                        if total_bytes and speed:
                            speed_str = f"{speed / 1_000_000:.1f}MB/s" if speed > 1_000_000 else f"{speed / 1_000:.0f}KB/s"
                            pbar.update(task_id, description=f"[{trk_num}/{trk_total}] {trk_title[:45]} • {speed_str}")
                    elif d["status"] == "finished":
                        pbar.update(task_id, description=f"[{trk_num}/{trk_total}] Converting {trk_title[:45]}...")
                return hook

            ydl_opts["progress_hooks"] = [make_hook(track_num, total, title, progress, dl_task)]

            # Retry policy — see "Failure Handling" above. A track only
            # counts as downloaded once its file is really on disk.
            downloaded = False
            failure: Exception | None = None
            failure_kind = "transient"
            attempt = 0

            while True:
                try:
                    final_mp3 = _fetch_track(
                        entry_url, ydl_opts, album_dir, track_num,
                        safe_title, metadata, title, entry_artist,
                    )
                except Exception as e:
                    failure = e
                    failure_kind = classify_failure(e)
                    if failure_kind == "block":
                        block_seen = True

                    # Cleanup temp files before retry
                    for f in album_dir.glob(f"__tmp_{track_num}*"):
                        f.unlink(missing_ok=True)

                    policy = _RETRY_POLICY[failure_kind]
                    if failure_kind == "gone" or attempt >= policy["tries"]:
                        break  # permanently unavailable, or out of retries

                    wait = _retry_wait(failure_kind, attempt)
                    attempt += 1
                    progress.update(
                        dl_task,
                        description=(
                            f"[{track_num}/{total}] {_FAILURE_LABEL[failure_kind]}"
                            f" — retry {attempt}/{policy['tries']} in {wait}s"
                        ),
                    )
                    time.sleep(wait)
                    continue

                stats["success"] += 1
                downloaded = True

                # Lyrics
                if lyrics:
                    progress.update(dl_task, description=f"[{track_num}/{total}] Lyrics — {title[:40]}")
                    try:
                        if fetch_and_store_lyrics(final_mp3, title, entry_artist,
                                                  metadata["album"], entry.get("duration"), safe):
                            stats["lyrics"] += 1
                    except Exception:
                        pass

                # Cover art — album cover, or this video's own
                # thumbnail as a last resort
                if art:
                    cover = album_art
                    if not cover:
                        raw = _download_image(entry.get("thumbnail") or "")
                        cover = _image_normalize(raw) if raw else None
                    if cover and embed_art(final_mp3, cover[0], cover[1]):
                        stats["art"] += 1

                break

            if not downloaded:
                stats["failed"] += 1
                stats["failed_tracks"].append(
                    f"{track_num:02d}. {title} ({_FAILURE_NOTE[failure_kind]})"
                )

            # Delay between tracks to avoid rate limiting
            if downloaded and i < total - 1:
                if safe:
                    # Safe mode: longer, random wait with visible message
                    wait = random.uniform(6, 12)
                    progress.update(
                        dl_task,
                        description=f"⏳ Waiting {wait:.0f}s to avoid bot detection...",
                    )
                    time.sleep(wait)
                elif block_seen:
                    # YouTube twitched at us earlier — ease off for the rest
                    # of the album instead of asking for trouble again.
                    progress.update(
                        dl_task,
                        description="⏳ 403 earlier — waiting 10s before the next track...",
                    )
                    time.sleep(10)
                else:
                    time.sleep(1.5)

            progress.update(dl_task, advance=1)

    stats["blocked"] = block_seen
    return stats


# ─── Summary ──────────────────────────────────────────────────────

def display_summary(stats: dict, location: Path, albums: int = 0) -> None:
    console.print()
    lines = []
    if stats["success"] > 0:
        lines.append(f"[green]✓ {stats['success']} downloaded[/]")
    if stats["skipped"] > 0:
        lines.append(f"[yellow]● {stats['skipped']} skipped (already existed)[/]")
    if stats["failed"] > 0:
        lines.append(f"[red]✗ {stats['failed']} failed[/]")
    if stats.get("lyrics"):
        lines.append(f"[magenta]♪ {stats['lyrics']} with lyrics[/]")
    if stats.get("art"):
        lines.append(f"[cyan]🖼 {stats['art']} with cover art[/]")
    if albums:
        lines.append(f"[blue]💿 {albums} album{'s' if albums != 1 else ''}[/]")

    summary = " • ".join(lines)
    console.print(summary)
    console.print(f"[dim]📁 {location}[/]")

    if stats.get("failed_albums"):
        console.print("\n[bold red]Albums that could not be read:[/]")
        for t in stats["failed_albums"]:
            console.print(f"  [dim]• {t}[/]")

    if stats["failed_tracks"]:
        console.print("\n[bold red]Failed tracks:[/]")
        for t in stats["failed_tracks"]:
            console.print(f"  [dim]• {t}[/]")

    if stats["failed_tracks"] or stats.get("failed_albums"):
        console.print(
            "\n[dim]Re-run the same command to retry just these — "
            "everything already on disk is skipped.[/]"
        )
        if stats.get("blocked"):
            console.print("[dim]Tip: give it a few minutes first, or use --safe.[/]")

    console.print()


