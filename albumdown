def _get_music_dir() -> Path:
    """Get the user's Music folder for the current platform."""
    if _IS_WINDOWS:
        # Ask Windows where the Music folder actually is
        # (handles users who moved it to another drive)
        try:
            import ctypes
            from ctypes import wintypes

            _FOLDERID_Music = ctypes.c_char_p(
                b"{4BD8D571-6D19-48D3-BE97-422220080E43}"
            )
            _SHGetKnownFolderPath = ctypes.windll.shell32.SHGetKnownFolderPath
            _SHGetKnownFolderPath.argtypes = [
                ctypes.c_char_p, wintypes.DWORD, wintypes.HANDLE,
                ctypes.POINTER(ctypes.c_wchar_p),
            ]
            _SHGetKnownFolderPath.restype = ctypes.HRESULT

            path_ptr = ctypes.c_wchar_p()
            result = _SHGetKnownFolderPath(_FOLDERID_Music, 0, 0, ctypes.byref(path_ptr))
            if result == 0:  # S_OK
                return Path(path_ptr.value)
        except Exception:
            pass
        # Fallback
        return Path.home() / "Music"
    else:
        # Linux / macOS — read XDG user-dirs config (handles localized folders)
        # e.g. ~/Musica on Spanish systems, ~/Musik on German, etc.
        try:
            xdg_file = Path.home() / ".config" / "user-dirs.dirs"
            if xdg_file.exists():
                for line in xdg_file.read_text().splitlines():
                    if line.startswith("XDG_MUSIC_DIR"):
                        # Format: XDG_MUSIC_DIR="$HOME/Música"
                        _, _, value = line.partition("=")
                        value = value.strip().strip('"')
                        value = value.replace("$HOME", str(Path.home()))
                        path = Path(value)
                        if path.is_dir():
                            return path
        except Exception:
            pass
        # Fallback
        return Path.home() / "Music"


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="albumdown",
        description="Download YouTube Music albums — or a whole artist's discography — as MP3s.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "Examples:\n"
            '  albumdown "https://music.youtube.com/playlist?list=PLxxxxx"\n'
            '  albumdown "https://youtube.com/playlist?list=PLxxxxx" -o ~/Downloads\n'
            '  albumdown "https://music.youtube.com/channel/UCxxxxx"\n'
            '  albumdown "@artisthandle" --include-singles\n'
            '  albumdown "https://music.youtube.com/channel/UCxxxxx" --all --no-confirm'
        ),
    )
    parser.add_argument(
        "url",
        help="YouTube/YouTube Music playlist URL, or an artist URL (channel / @handle) for a full discography",
    )
    parser.add_argument(
        "-o", "--output",
        default=str(_get_music_dir()),
        help="Output directory (default: ~/Music)",
    )
    parser.add_argument(
        "--quality",
        type=int,
        default=0,
        choices=range(0, 11),
        metavar="0-10",
        help="MP3 quality: 0=best, 10=worst (default: 0)",
    )
    parser.add_argument(
        "--no-confirm",
        action="store_true",
        help="Skip the confirmation prompt before downloading",
    )
    parser.add_argument(
        "--all",
        action="store_true",
        help="Artist mode: download every release in scope — skips the picker and the confirmation",
    )
    parser.add_argument(
        "--include-singles",
        action="store_true",
        help="Artist mode: offer singles & EPs as well (albums only by default)",
    )
    parser.add_argument(
        "--safe",
        action="store_true",
        help="Slower, gentler downloads — adds delays between requests to avoid bot detection",
    )
    parser.add_argument(
        "--cookies",
        metavar="FILE",
        default=None,
        help="Path to a cookies.txt file (Netscape format) for authenticated downloads",
    )
    parser.add_argument(
        "--lyrics",
        action="store_true",
        help="Fetch lyrics from LRCLIB — writes .lrc files and embeds them in the MP3s",
    )
    parser.add_argument(
        "--no-art",
        action="store_true",
        help="Skip embedding album cover art",
    )
    return parser.parse_args()


def run_playlist(args: argparse.Namespace, output_base: str) -> None:
    """Single-album flow: one playlist URL → one album folder."""
    # Fetch metadata
    with console.status("[bold blue]Fetching album info...", spinner="dots"):
        metadata = fetch_metadata(args.url)

    if not metadata["entries"]:
        console.print("[bold red]Error:[/] No tracks found in this playlist.")
        sys.exit(1)

    # Adopt an existing case-variant artist folder before showing anything,
    # so the header, folder and embedded tags all use one spelling
    _merge_artist_folder(metadata, Path(output_base))

    # Display tracklist
    display_tracklist(metadata)

    # Confirm
    if not args.no_confirm:
        track_count = len(metadata["entries"])
        if not Confirm.ask(
            f"[bold]Download {track_count} track{'s' if track_count != 1 else ''}?",
            default=True,
        ):
            console.print("[dim]Cancelled.[/]")
            sys.exit(0)

    # Create output directory
    album_dir = make_output_dir(metadata, output_base)
    console.print(f"[dim]📁 Saving to: {album_dir}[/]\n")

    # Download
    start = time.time()
    stats = download_album(
        metadata, album_dir,
        quality=args.quality,
        safe=args.safe,
        cookies=args.cookies,
        lyrics=args.lyrics,
        art=not args.no_art,
    )
    elapsed = time.time() - start

    # Summary
    display_summary(stats, album_dir)
    console.print(f"[dim]Finished in {format_duration(elapsed)}[/]")


def run_artist(args: argparse.Namespace, output_base: str) -> None:
    """Full-artist flow: one artist URL → every selected release, album by album."""
    with console.status("[bold blue]Reading artist page...", spinner="dots"):
        catalog = fetch_artist_catalog(args.url, cookies=args.cookies)

    if not catalog:
        console.print("[bold red]Error:[/] Could not read this artist page.")
        console.print("  [dim]Check the URL — or YouTube may be rate-limiting you (try --cookies).[/]")
        sys.exit(1)
    if not catalog["releases"]:
        console.print("[bold red]Error:[/] No albums or singles found on this channel.")
        console.print("  [dim]This doesn't look like a YouTube Music artist page.[/]")
        sys.exit(1)

    # Adopt an existing case-variant artist folder first, so the picker, the
    # folders and the embedded tags all agree on one spelling
    probe = {"artist": catalog["artist"], "entries": []}
    _merge_artist_folder(probe, Path(output_base))
    catalog["artist"] = probe["artist"]
    artist_dir = Path(output_base) / _sanitize(catalog["artist"])

    shown = display_release_catalog(catalog, args.include_singles)
    if not shown:
        console.print("[bold red]Error:[/] Nothing to download with the current filter.")
        sys.exit(1)

    if args.all:
        selected = shown
    else:
        selected = [shown[i - 1] for i in ask_release_selection(len(shown))]
        if not selected:
            console.print("[dim]Cancelled.[/]")
            sys.exit(0)
        if not args.no_confirm and not Confirm.ask(
            f"[bold]Download {len(selected)} release{'s' if len(selected) != 1 else ''}?",
            default=True,
        ):
            console.print("[dim]Cancelled.[/]")
            sys.exit(0)

    count = len(selected)
    console.print(f"\n[bold]📀 {catalog['artist']} — {count} release{'s' if count != 1 else ''}[/]")
    console.print(f"[dim]📁 {artist_dir}[/]\n")

    totals = {
        "success": 0, "skipped": 0, "failed": 0,
        "failed_tracks": [], "failed_albums": [],
        "lyrics": 0, "art": 0, "blocked": False,
    }
    albums_done = 0
    start = time.time()

    for position, release in enumerate(selected, 1):
        title = release["title"]
        year = f" [dim]({release['year']})[/]" if release["year"] else ""
        console.print(f"[bold cyan]▸ {position}/{count}[/] {title}{year}")

        # Catalog names are the source of truth here: flat extraction fetches
        # a whole album in one request but carries no per-entry tags.
        playlist_url = f"https://music.youtube.com/playlist?list={release['playlist_id']}"
        metadata = fetch_metadata(playlist_url, flat=True, fatal=False)
        if not metadata or not metadata.get("entries"):
            totals["failed_albums"].append(title)
            console.print("  [red]✗ could not read this release — skipping[/]")
            _album_delay(args.safe, position, count, totals["blocked"])
            continue

        metadata["album"] = title
        if catalog["artist"] != "Unknown Artist":
            metadata["artist"] = catalog["artist"]
        # Playlist art (1200px) stays first; the shelf thumb is a fallback
        if release.get("thumbnail") and release["thumbnail"] not in metadata.get("cover_urls", []):
            metadata["cover_urls"] = metadata.get("cover_urls", []) + [release["thumbnail"]]

        _merge_artist_folder(metadata, Path(output_base))
        album_dir = make_output_dir(metadata, output_base)

        stats = download_album(
            metadata, album_dir,
            quality=args.quality,
            safe=args.safe,
            cookies=args.cookies,
            lyrics=args.lyrics,
            art=not args.no_art,
        )
        for key in ("success", "skipped", "failed", "lyrics", "art"):
            totals[key] += stats.get(key, 0)
        totals["blocked"] = totals["blocked"] or bool(stats.get("blocked"))
        totals["failed_tracks"] += [f"{title} — {t}" for t in stats.get("failed_tracks", [])]
        albums_done += 1

        _album_delay(args.safe, position, count, totals["blocked"])

    elapsed = time.time() - start
    display_summary(totals, artist_dir, albums=albums_done)
    console.print(f"[dim]Finished in {format_duration(elapsed)}[/]")


def _album_delay(safe: bool, position: int, count: int, blocked: bool = False) -> None:
    """Breathe between releases — a discography is many playlists in a row."""
    if position >= count:
        return
    if blocked:
        # A 403 happened somewhere in this run — give YouTube real room
        wait = random.uniform(20, 40)
        console.print(f"[dim]⏳ 403 earlier — waiting {wait:.0f}s before the next album...[/]")
        time.sleep(wait)
    elif safe:
        wait = random.uniform(6, 12)
        console.print(f"[dim]⏳ Waiting {wait:.0f}s to avoid bot detection...[/]")
        time.sleep(wait)
    else:
        time.sleep(3)


def main():
    args = parse_args()

    kind_target = classify_url(args.url)
    if not kind_target:
        console.print("[bold red]Error:[/] Invalid URL.")
        console.print("  Give a YouTube or YouTube Music playlist URL, or an artist page:")
        console.print("  [dim]https://music.youtube.com/playlist?list=PLxxxxx[/]")
        console.print("  [dim]https://music.youtube.com/channel/UCxxxxx · @artisthandle[/]")
        sys.exit(1)

    output_base = os.path.expanduser(args.output)
    if not os.path.isdir(output_base):
        console.print(f"[bold red]Error:[/] Output directory does not exist: {output_base}")
        sys.exit(1)

    kind, _ = kind_target
    if kind == "artist":
        run_artist(args, output_base)
    else:
        run_playlist(args, output_base)


if __name__ == "__main__":
    main()
